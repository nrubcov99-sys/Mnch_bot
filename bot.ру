import os
import threading
from flask import Flask
from telegram import Update
from telegram.ext import ApplicationBuilder, CommandHandler, MessageHandler, filters, ContextTypes

# ------------------- KEEP-ALIVE (веб-сервер) -------------------
app_web = Flask('')

@app_web.route('/')
def home():
    return "Бот жив!"

def run():
    app_web.run(host='0.0.0.0', port=8080)

def keep_alive():
    t = threading.Thread(target=run)
    t.start()
# ----------------------------------------------------------------

TOKEN = os.environ.get("TELEGRAM_BOT_TOKEN")
if not TOKEN:
    raise ValueError("Токен не найден! Добавь его в переменные окружения Render.")

YOUR_CHAT_ID = os.environ.get("TELEGRAM_CHAT_ID")
if not YOUR_CHAT_ID:
    raise ValueError("Chat ID не найден! Добавь его в переменные окружения Render.")

async def start(update: Update, context: ContextTypes.DEFAULT_TYPE):
    await update.message.reply_text(
        "🔧 Привет! Я бот сантехнической службы.\n\n"
        "Напиши кратко, что случилось — и я передам мастеру.\n"
        "Цены можно узнать по команде /price"
    )

async def price(update: Update, context: ContextTypes.DEFAULT_TYPE):
    await update.message.reply_text(
        "💰 Наши цены:\n"
        "• Замена унитаза — от 2000 руб.\n"
        "• Устранение засора — от 1500 руб.\n"
        "• Замена смесителя — от 1800 руб.\n"
        "• Установка счётчиков — от 2500 руб.\n"
        "• Замена фильтров — от 1200 руб.\n"
        "• Замена сифона — от 1000 руб.\n\n"
        "Точная стоимость после осмотра."
    )

async def forward_message(update: Update, context: ContextTypes.DEFAULT_TYPE):
    user = update.message.from_user
    text = update.message.text
    await context.bot.send_message(
        chat_id=YOUR_CHAT_ID,
        text=f"📩 Новая заявка!\nОт: @{user.username or 'без username'} (ID: {user.id})\nТекст: {text}"
    )
    await update.message.reply_text("✅ Заявка принята! Мастер свяжется с вами в ближайшее время.")

try:
    app_bot = ApplicationBuilder().token(TOKEN).build()
    app_bot.add_handler(CommandHandler("start", start))
    app_bot.add_handler(CommandHandler("price", price))
    app_bot.add_handler(MessageHandler(filters.TEXT & ~filters.COMMAND, forward_message))

    if __name__ == "__main__":
        keep_alive()
        print("🤖 Бот запущен и готов к работе 24/7!")
        app_bot.run_polling()
except Exception as e:
    print(f"Ошибка при запуске бота: {e}")
